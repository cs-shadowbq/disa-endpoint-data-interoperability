#!/usr/bin/env python3
"""
XLS Extractor - Command-line tool for extracting Excel sheets.

This script serves as the executable entry point for the xls-extractor tool.
"""

from xls_extractor.__main__ import main
import sys
from pathlib import Path

# Add the src directory to the path if running from bin
src_path = Path(__file__).parent.parent / "src"
if src_path.exists():
    sys.path.insert(0, str(src_path))


if __name__ == "__main__":
    sys.exit(main())
